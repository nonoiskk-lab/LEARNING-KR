# --- Core ---
DATABASE_URL="file:./dev.db"            # Postgres in production: postgresql://user:pass@host:5432/fluentia
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
APP_URL="http://localhost:3000"
ADMIN_EMAILS="you@example.com"           # comma-separated; these accounts see /admin

# --- AI brain. Without any key the app runs on the built-in offline demo tutor. ---
TEACHER_PROVIDER=""                      # claude | gemini | demo. Empty = first key found (Claude, then Gemini)
ANTHROPIC_API_KEY=""
TEACHER_MODEL="claude-opus-5-5"
TEACHER_EFFORT="low"                     # low keeps conversational latency down

# Google Gemini (free tier available at aistudio.google.com — note its rate limits and data-use terms)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_THINKING_LEVEL="LOW"              # set "" for models without thinking levels
GEMINI_PRICE_INPUT_PER_MTOK="0"          # USD per 1M tokens, for the admin cost dashboard (0 on free tier)
GEMINI_PRICE_OUTPUT_PER_MTOK="0"

# --- Voice (optional). Without these the browser's Web Speech API is used. ---
TTS_PROVIDER="browser"                   # browser | elevenlabs
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""

# --- Avatar (optional). "portrait" = built-in animated portrait. ---
AVATAR_PROVIDER="portrait"               # portrait | video (see docs/ARCHITECTURE.md §6)

# --- Billing (optional). Without Stripe keys, upgrades run in demo mode in dev only. ---
BILLING_DEMO_MODE="false"               # "true" allows fake upgrades on a staging build; never on public prod
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PREMIUM_MONTHLY=""
STRIPE_PRICE_PREMIUM_YEARLY=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""
